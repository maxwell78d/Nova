# ============================================
# Nova Academy — Variables de Entorno
# ============================================

# URL de la aplicación (Render la asigna automáticamente)
APP_URL="https://tu-app.onrender.com"

# Puerto del servidor (Render usa 4000 por defecto)
PORT=4000

# Entorno
NODE_ENV=production

# Groq API Keys (para chatbot y evaluaciones IA)
GROQ_API_KEY="tu_groq_api_key"
GROQ_EVAL_KEY="tu_groq_eval_key"
GROQ_GEN_KEY="tu_groq_gen_key"
