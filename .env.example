# ============================================
# Nova Academy — Production Environment Variables
# ============================================

NODE_ENV=production
PORT=3000

# Firebase Admin SDK (Get these from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Groq API Keys (for chatbot and evaluations IA)
GROQ_API_KEY="gsk_xxxx"
GROQ_EVAL_KEY="gsk_xxxx"
GROQ_GEN_KEY="gsk_xxxx"
